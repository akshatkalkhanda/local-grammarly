{
  "name": "grammerly-clone",
  "private": true,
  "version": "0.0.0",
  "description": "A local, privacy-focused AI writing assistant powered by Ollama.",
  "author": "AI Editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "lint": "oxlint --ignore-pattern dist --ignore-pattern dist-electron --ignore-pattern release",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.aieditor.app",
    "productName": "AI Editor",
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
